# ---- Runtime mode ----
# true = in-memory mock Ravencoin node (default; nothing touches chain)
MOCK_RVN=true
PORT=3001

# ---- Real node (only used when MOCK_RVN=false) ----
# Point at a ravend with -server=1. Use TESTNET while developing.
RVN_RPC_URL=http://127.0.0.1:18766
RVN_RPC_USER=
RVN_RPC_PASS=
RVN_NETWORK=testnet
